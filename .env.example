# Development-only example. Production startup rejects placeholders, weak secrets, HTTP origins, and relative storage paths.
NODE_ENV="development"
DATABASE_URL="postgresql://personalise_kings:personalise_kings@localhost:5432/personalise_kings?schema=public"
OBJECT_STORAGE_ROOT="./storage"
OBJECT_STORAGE_MAX_BYTES="26214400"
PK_WEBAPP_URL="http://localhost:3000"
PK_CUSTOMISER_URL="http://localhost:3001"
PK_API_URL="http://localhost:3002"
# Base64-encoded 32-byte key for encrypted staff TOTP secrets.
PK_ADMIN_MFA_ENCRYPTION_KEY=""
# Random server-only HMAC key for one-time recovery codes.
PK_ADMIN_RECOVERY_CODE_PEPPER=""
PK_EMBED_TOKEN_SECRET=""
PK_OBJECT_URL_SECRET=""
# Base64-encoded 32-byte AES key. Generate with: openssl rand -base64 32
PK_CONNECTOR_SECRET_ENCRYPTION_KEY=""
PK_DEMO_CONNECTOR_SECRET=""
# Explicitly permits the known local demonstration fixture. Never set in production.
PK_ALLOW_DEMO_SEED="true"
# Enables development-only bypass features when their dedicated flag is also enabled.
PK_ENABLE_INSECURE_DEVELOPMENT="false"
# Development only. Production store URLs must always resolve to public addresses.
PK_ALLOW_PRIVATE_STORE_URLS="false"
# Optional path to a pinned Chromium executable for the proof worker.
PK_PROOF_CHROMIUM_EXECUTABLE_PATH=""
PROOF_JOB_POLL_INTERVAL_MS="5000"
PROOF_JOB_MAX_ATTEMPTS="5"
PK_CONNECTOR_REPLAY_WINDOW_SECONDS="300"
PK_CUSTOMISATION_TTL_SECONDS="86400"
PRINT_JOB_POLL_INTERVAL_MS="5000"
MAINTENANCE_POLL_INTERVAL_MS="5000"
CLEANUP_INTERVAL_MS="60000"
# Optional signed out-of-band delivery for operational alert transitions.
PK_OPERATIONS_ALERT_WEBHOOK_URL=""
PK_OPERATIONS_ALERT_WEBHOOK_SECRET=""
PK_OPERATIONS_ALERT_TIMEOUT_MS="5000"
# Optional OTLP/HTTP base endpoint. Headers use the standard key=value comma-separated format.
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""
OTEL_SERVICE_VERSION="development"
OTEL_METRIC_EXPORT_INTERVAL_MS="60000"
